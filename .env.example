# --- Supabase (Project Settings -> API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon" (legacy) or "publishable" key. Never put the service_role / secret key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# --- Hotel settings ---------------------------------------------------------
# IANA time zone of the hotel. Controls what "today" means for check-outs and how times are shown.
# Examples: America/Port-au-Prince, America/Santo_Domingo, America/New_York, UTC
NEXT_PUBLIC_HOTEL_TIMEZONE=America/Port-au-Prince

# ISO 4217 currency code used to display prices (USD, HTG, DOP, EUR ...).
NEXT_PUBLIC_CURRENCY=USD

# --- Access codes (SERVER ONLY: never add the NEXT_PUBLIC_ prefix to these) ---------------
# Two ways in: the RECEPTION code registers guests and handles stays; the ADMIN code also opens
# Reports, the Guest directory and room setup. Exactly 4 digits each, and they must differ.
# Avoid obvious codes (0000, 1234) if the app can be reached from outside the hotel.
RECEPTION_PIN=
ADMIN_PIN=

# Secret mixed into the stored code hashes when the administrator changes a code on the
# Settings screen. Set it once to any long random string and never change it afterwards
# (changing it makes the codes stored in the app unusable; the codes above still work).
# If left empty, ADMIN_PASSWORD is used instead.
PIN_PEPPER=

# The two accounts behind the codes. Create them in Supabase (Authentication -> Users -> Add user,
# tick "Auto Confirm User"), ADMIN FIRST, then copy the same email + password here.
# Use email addresses you control: anyone who can receive mail there can request a password reset.
ADMIN_EMAIL=
ADMIN_PASSWORD=
RECEPTION_EMAIL=
RECEPTION_PASSWORD=

# Minutes without activity before an administrator session locks itself (0 = never).
ADMIN_IDLE_MINUTES=10
